# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Every value here is optional except where noted.
#
# The repo runs end to end with this file completely empty: the graph falls back
# to the local mirror over the staged parquet, and the agent writes its prose
# from deterministic templates. Verdicts, probabilities, actions and approval
# routes are identical either way — only the wording changes, and only the
# backend changes. Fill this in to run against a real TigerGraph workspace and
# a real model.
#
# See SETUP_REQUIRED_FROM_YOU.md for where each value comes from.
# ─────────────────────────────────────────────────────────────────────────────

# ── TigerGraph ───────────────────────────────────────────────────────────────
# Savanna: the workspace URL from savanna.tgcloud.io. Community Edition:
# http://localhost. Leave blank to use the local mirror.
TG_HOST=
TG_GRAPH_NAME=
TG_USERNAME=
TG_PASSWORD=
TG_SECRET=
TG_TOKEN=
TG_RESTPP_PORT=9000
TG_GSQL_PORT=14240
TG_VERSION=4.2.0
# Route the agent's graph calls through the TigerGraph MCP server (tigergraph-mcp).
# 0 = direct pyTigerGraph connection. Falls back to direct automatically on failure.
TG_VIA_MCP=1

# local | tigergraph | auto   (auto = tigergraph when credentials are present)
GRAPH_BACKEND=auto
# 1 = fail closed: raise instead of falling back to the local mirror when TigerGraph
# is unreachable, so results are never silently served from the mirror.
GRAPH_STRICT=1
# 1 = stop if the MCP server fails instead of degrading to the direct connection
MCP_STRICT=0
# Least privilege: the agent may call only these MCP tools / installed queries.
# Empty = the defaults in graphstore/mcp_client.py and graphstore/tigergraph.py.
TG_ALLOWED_TOOLS=
TG_ALLOWED_QUERIES=
# Name of the graph load, folded into every attestation's data_snapshot.
TG_LOAD_VERSION=

# ── LLM ──────────────────────────────────────────────────────────────────────
# Used for tool planning and prose only. It never produces a probability, an
# action, an approval route or an identifier — those come from `core/`, which
# cannot import an LLM client (enforced by tests/test_core_purity.py).
LLM_PROVIDER=
LLM_MODEL=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=
LLM_CACHE_ENABLED=
LLM_CACHE_DIR=.cache/llm
AGENT_USE_LLM=1

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Embeddings ───────────────────────────────────────────────────────────────
# auto  = sentence-transformers if the weights are reachable, else TF-IDF+SVD
# tfidf = fully offline and byte-reproducible, downloads nothing
# EMBEDDING_DIM must match the DIMENSION in graph/ddl/02_vectors.gsql. Changing
# it means dropping and recreating every vector attribute, so fix it first.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Agent behaviour — these are the tuning dials ─────────────────────────────
MAX_EVIDENCE_ROUNDS=3
MIN_VOI_PER_UNIT_COST=0.010
EPISODE_WINDOW_HOURS=72

# Thresholds come from the bank's Fraud Policy §6, not from taste.
POSTERIOR_THRESHOLD_BLOCK_ALL=0.85
POSTERIOR_THRESHOLD_BLOCK_CARD=0.70
POSTERIOR_THRESHOLD_DECLINE=0.55
POSTERIOR_THRESHOLD_MONITOR=0.30
POSTERIOR_THRESHOLD_CLEAR=0.15
POSTERIOR_THRESHOLD_CASE=0.30
HYPOTHESIS_SEPARATION_FLOOR=0.15
AGENT_WALL_CLOCK_TIMEOUT_S=240
AGENT_TOKEN_BUDGET=120000

# ── Simulation ───────────────────────────────────────────────────────────────
# Customer and analyst replies are not provided by the dataset. Responses are
# simulated deterministically from the case identity, never from any outcome
# label, and every answer file records what was assumed.
SIMULATION_SEED=4471
SIMULATE_CUSTOMER_RESPONSES=true
SIMULATED_NO_RESPONSE_RATE=0.18

# ── Paths ────────────────────────────────────────────────────────────────────
DATA_RAW_DIR=./Datasets
DATA_STAGED_DIR=./data/staged
POLICY_DIR=./data/policy
BENCHMARK_OUTPUT_DIR=./cases
EVAL_OUTPUT_DIR=./eval/reports
MONITORING_OUTPUT_DIR=./benchmark/autonomous

# ── Observability (optional) ─────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tigergraph-fraud-agent

# ── Approvals (server-side) ─────────────────────────────────────────────────
# actor_id:role:sha256(token), comma-separated. Generate with `make tokens`;
# hand the plaintext to people, put only this line here. Roles: analyst,
# team_lead (L1), fraud_manager (L2).
APPROVAL_TOKENS=
# Ed25519 seed (hex) for signing approvals; empty = a key in .cache/ is created.
APPROVAL_SIGNING_KEY=

# ── Harness ─────────────────────────────────────────────────────────────────
LLM_TIMEOUT_S=45
# Relative-rule hardening of the structuring detector (eval/attacks.py).
FRONTIER_HARDENING=0
